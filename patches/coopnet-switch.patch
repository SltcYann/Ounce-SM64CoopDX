 }
 
+#ifdef __SWITCH__
+// The Switch has no getifaddrs() or interface MAC addresses. Use a random
+// value made once and kept next to the game (the game makes its folder the
+// current directory at startup), so the console keeps the same info bits
+// between launches.
+uint64_t SocketGetInfoBits(int aSocket) {
+    (void)aSocket;
+    const char* path = "coopnet-id.bin";
+    uint64_t value = 0;
+    FILE* f = fopen(path, "rb");
+    if (f) {
+        if (fread(&value, sizeof(value), 1, f) != 1) { value = 0; }
+        fclose(f);
+    }
+    if (value == 0) {
+        // libnx's CSPRNG: std::random_device has no OS entropy source here
+        value = randomGet64();
+        if (value == 0) { value = 1; }
+        f = fopen(path, "wb");
+        if (f) {
+            fwrite(&value, sizeof(value), 1, f);
+            fclose(f);
+        }
+    }
+    return SocketAddHash(SOCKET_DEFAULT_INFO + value);
+}
+#else
 uint64_t SocketGetInfoBits(int aSocket) {
